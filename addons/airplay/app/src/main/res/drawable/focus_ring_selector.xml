<?xml version="1.0" encoding="utf-8"?>
<!--
    focus_ring_selector.xml — tvOS-style background for interactive rows/cards.
    Focused: an opaque white rounded plate (text inverts via @color/tv_text_*); pressed: slightly
    dimmer; unfocused: a faint translucent plate so grouped rows still read as rows.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
