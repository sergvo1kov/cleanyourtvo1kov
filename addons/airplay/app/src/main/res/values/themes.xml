<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base theme — dark TV theme based on Google TV Streamer design language.
        - True black background for OLED-friendly displays
        - Accent blue for focus and active states
        - Leanback parent for D-pad / TV launcher compatibility
    -->
    <style name="Theme.PhairPlay" parent="@style/Theme.AppCompat.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorPrimary">@color/accent_blue</item>
        <item name="android:colorPrimaryDark">@color/background_dark</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <!-- Inter everywhere: the free stand-in for Apple's SF Pro (tvOS look). -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Fullscreen theme: hides status bar for StreamingScreen -->
    <style name="Theme.PhairPlay.Fullscreen" parent="Theme.PhairPlay">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- tvOS button: translucent plate, white with dark text when focused, lifts on focus. -->
    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:background">@drawable/btn_control_selector</item>
        <item name="android:stateListAnimator">@animator/tv_focus_lift</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
